type Query {
    tenant(id: ID!): Tenant
    latestTenants(limit: Int = 10): [Tenant!]!
    tenantsByTag(tag: String!): [Tenant!]!
}

type Mutation {
    summarizeTenant(id: ID!): TenantSummary!
}

type Tenant {
    id: ID!
    # Nullable display fields consumed by the multistate-web UI list view. They
    # are additive: existing queries (and the GraphQL ITs) that don't select them
    # are unaffected, and a read model without a name/capturedAt resolves to null
    # rather than violating a non-null contract.
    name: String
    updatedAt: String
    lines: [LineItem!]!
    tags: [String!]!
}

type LineItem {
    id: ID!
    description: String!
    amount: Float!
}

type TenantSummary {
    primaryState: String!
    totalAllocation: Float!
    stateCount: Int!
    complianceTier: String!
}
